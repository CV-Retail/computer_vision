# --- Lado servidor (perfiles all-in-one y server) ---
POSTGRES_USER=kiosko
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kiosko
# Obligatoria: el bus de eventos (Valkey, protocolo Redis) no arranca sin ella. Cámbiala antes de usar el sistema fuera de pruebas.
REDIS_PASSWORD=change-me
# Puerto del host para el portal web (admin y player). Usa otro si el 80 está ocupado.
WEB_PORT=80
# Dirección en la que el bus de eventos (Redis/Valkey) escucha en el host. 127.0.0.1 = solo esta máquina.
# En el servidor con estaciones separadas, pon la IP de la LAN (o 0.0.0.0). Nunca lo expongas a internet.
REDIS_BIND_ADDR=127.0.0.1

# --- Estación separada (perfil kiosk) ---
# Apunta visión al Redis del servidor. Si no se define, vision-service usa el servicio redis de este mismo compose.
# EVENT_TRANSPORT_URL=redis://:<password>@<server-host>:6379/0
